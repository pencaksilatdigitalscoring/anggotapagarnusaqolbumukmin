    <script>
        // --- KONFIGURASI FIREBASE ---
        const firebaseConfig = {
  apiKey: "AIzaSyAXSl_g8nzWMVuu7XtyggxxHu0lNQ6kE4A",
  authDomain: "pagar-nusa-qolbu-mukmin.firebaseapp.com",
  databaseURL: "https://pagar-nusa-qolbu-mukmin-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId: "pagar-nusa-qolbu-mukmin",
  storageBucket: "pagar-nusa-qolbu-mukmin.firebasestorage.app",
  messagingSenderId: "936030973642",
  appId: "1:936030973642:web:15389ba09ab12ac9af0e33"
};

        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();

        // State Portal Anggota
        let anggotaAktif = null;
        let dataAgenda = [];
        let dataRayon = [];
        let dataKeuangan = [];
        let dataSurat = [];
        let listenersAktif = false;

        // State Sidebar (Desktop default terbuka, Mobile default tertutup)
        let lastIsDesktop = window.innerWidth >= 1024;
        let sidebarTerbuka = lastIsDesktop;

        function setSidebar(buka) {
            sidebarTerbuka = buka;
            terapkanStateSidebar();
        }

        function toggleSidebar() {
            sidebarTerbuka = !sidebarTerbuka;
            terapkanStateSidebar();
        }

        function terapkanStateSidebar() {
            const sidebar = document.getElementById("portal-sidebar");
            const overlay = document.getElementById("sidebar-overlay");
            const isDesktop = window.innerWidth >= 1024;

            if (isDesktop) {
                overlay.classList.add("hidden");
                sidebar.classList.remove("translate-x-0", "-translate-x-full");
                if (sidebarTerbuka) {
                    sidebar.classList.remove("lg:-ml-72", "lg:opacity-0", "lg:pointer-events-none");
                    sidebar.classList.add("lg:ml-0", "lg:opacity-100");
                } else {
                    sidebar.classList.remove("lg:ml-0", "lg:opacity-100");
                    sidebar.classList.add("lg:-ml-72", "lg:opacity-0", "lg:pointer-events-none");
                }
            } else {
                sidebar.classList.remove("lg:-ml-72", "lg:opacity-0", "lg:pointer-events-none", "lg:ml-0", "lg:opacity-100");
                if (sidebarTerbuka) {
                    sidebar.classList.remove("-translate-x-full");
                    sidebar.classList.add("translate-x-0");
                    overlay.classList.remove("hidden");
                } else {
                    sidebar.classList.remove("translate-x-0");
                    sidebar.classList.add("-translate-x-full");
                    overlay.classList.add("hidden");
                }
            }
        }

        window.addEventListener("resize", () => {
            const isDesktopNow = window.innerWidth >= 1024;
            if (isDesktopNow !== lastIsDesktop) {
                lastIsDesktop = isDesktopNow;
                sidebarTerbuka = isDesktopNow;
                terapkanStateSidebar();
            }
        });

        // Helper keamanan HTML & JSON attribute
        function esc(str) {
            if (str === null || str === undefined) return "";
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function safeJsonAttr(val) {
            return JSON.stringify(val || "")
                .replace(/'/g, "\\u0027")
                .replace(/</g, "\\u003c")
                .replace(/>/g, "\\u003e");
        }

        // Normalisasi nomor WhatsApp agar 08... dan 628... tetap cocok
        function normalisasiWA(nomor) {
            let digits = String(nomor || "").replace(/\D/g, "");
            if (!digits) return "";
            if (digits.startsWith("62")) {
                digits = "0" + digits.slice(2);
            }
            return digits;
        }

        function formatTanggal(tglStr) {
            if (!tglStr || tglStr === "-") return "-";
            const date = new Date(tglStr);
            if (isNaN(date.getTime())) return esc(tglStr);
            return date.toLocaleDateString("id-ID", {
                day: "2-digit",
                month: "long",
                year: "numeric"
            });
        }

        function formatRupiah(num) {
            return "Rp " + parseFloat(num || 0).toLocaleString("id-ID");
        }

        function togglePassword() {
            const input = document.getElementById("login-wa");
            const icon = document.getElementById("icon-eye");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("fa-eye-slash", "fa-eye");
            }
        }

        // Proses Login Anggota
        async function prosesLoginAnggota(event) {
            event.preventDefault();
            const namaInput = document.getElementById("login-nama").value.trim();
            const waInput = document.getElementById("login-wa").value.trim();
            const errorBox = document.getElementById("login-error");
            const errorText = document.getElementById("login-error-text");
            const btn = document.getElementById("btn-login");

            errorBox.classList.add("hidden");

            const waNormInput = normalisasiWA(waInput);
            if (!namaInput || !waNormInput) {
                errorText.innerText = "Mohon isi Nama Anggota dan Nomor WhatsApp.";
                errorBox.classList.remove("hidden");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Memeriksa Data...</span>`;

            try {
                const snapshot = await database.ref("administrasi_digital/anggota").once("value");
                const rawAnggota = snapshot.val();
                const listAnggota = rawAnggota ? Object.values(rawAnggota) : [];

                const ditemukan = listAnggota.find(item => {
                    const namaDb = (item.nama_lengkap || "").trim().toLowerCase();
                    const waDbNorm = normalisasiWA(item.whatsapp);
                    return namaDb === namaInput.toLowerCase() && waDbNorm !== "" && waDbNorm === waNormInput;
                });

                if (ditemukan) {
                    anggotaAktif = ditemukan;
                    sessionStorage.setItem("anggota_id_login", String(ditemukan.id));
                    bukaPortalAnggota();
                } else {
                    errorText.innerText = "Nama anggota atau nomor WhatsApp tidak sesuai dengan database.";
                    errorBox.classList.remove("hidden");
                }
            } catch (err) {
                errorText.innerText = "Gagal terhubung ke server: " + err.message;
                errorBox.classList.remove("hidden");
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-right-to-bracket"></i> <span>MASUK PORTAL ANGGOTA</span>`;
            }
        }

        function bukaPortalAnggota() {
            document.getElementById("page-login").classList.add("hidden");
            document.getElementById("page-portal").classList.remove("hidden");
            sidebarTerbuka = window.innerWidth >= 1024;
            terapkanStateSidebar();
            renderBiodata();
            aktifkanRealtimeData();
        }

        function prosesLogout() {
            sessionStorage.removeItem("anggota_id_login");
            anggotaAktif = null;
            if (listenersAktif) {
                database.ref("administrasi_digital/anggota").off();
                database.ref("administrasi_digital/agenda").off();
                database.ref("administrasi_digital/rayon").off();
                database.ref("administrasi_digital/keuangan").off();
                database.ref("administrasi_digital/administrasi").off();
                listenersAktif = false;
            }
            document.getElementById("form-login-anggota").reset();
            document.getElementById("login-error").classList.add("hidden");
            document.getElementById("page-portal").classList.add("hidden");
            document.getElementById("page-login").classList.remove("hidden");
        }

        function aktifkanRealtimeData() {
            if (listenersAktif) return;
            listenersAktif = true;

            if (anggotaAktif && anggotaAktif.id) {
                database.ref("administrasi_digital/anggota/" + anggotaAktif.id).on("value", snap => {
                    if (snap.exists()) {
                        anggotaAktif = snap.val();
                        renderBiodata();
                    }
                });
            }

            database.ref("administrasi_digital/agenda").on("value", snap => {
                const val = snap.val();
                dataAgenda = val ? Object.values(val) : [];
                dataAgenda.sort((a, b) => new Date(b.tanggal_kegiatan || 0) - new Date(a.tanggal_kegiatan || 0));
                renderAgenda();
            });

            database.ref("administrasi_digital/rayon").on("value", snap => {
                const val = snap.val();
                dataRayon = val ? Object.values(val) : [];
                renderJadwalLatihan();
            });

            database.ref("administrasi_digital/keuangan").on("value", snap => {
                const val = snap.val();
                dataKeuangan = val ? Object.values(val) : [];
                dataKeuangan.sort((a, b) => new Date(b.tanggal || 0) - new Date(a.tanggal || 0));
                renderLaporanKas();
            });

            database.ref("administrasi_digital/administrasi").on("value", snap => {
                const val = snap.val();
                dataSurat = val ? Object.values(val) : [];
                dataSurat.sort((a, b) => new Date(b.tanggal_surat || 0) - new Date(a.tanggal_surat || 0));
                renderAdministrasiSurat();
            });
        }

        // Render Biodata Lengkap Pribadi
        function renderBiodata() {
            if (!anggotaAktif) return;
            const foto = anggotaAktif.foto || "https://via.placeholder.com/150?text=Foto";
            const nama = anggotaAktif.nama_lengkap || "-";
            const rayon = anggotaAktif.ranting_rayon || "-";

            document.getElementById("header-foto").src = foto;
            document.getElementById("sidebar-foto").src = foto;
            document.getElementById("sidebar-nama").innerText = nama;
            document.getElementById("sidebar-rayon").innerText = rayon;
            document.getElementById("topbar-subtitle").innerText = nama + " • " + rayon;

            document.getElementById("bio-foto").src = foto;
            document.getElementById("bio-nama").innerText = nama;
            document.getElementById("bio-nia").innerText = (anggotaAktif.nia && anggotaAktif.nia.trim() !== "") ? anggotaAktif.nia : "Belum Memiliki NIA";
            document.getElementById("bio-rayon").innerText = rayon;
            document.getElementById("bio-nik").innerText = anggotaAktif.nik || "-";
            document.getElementById("bio-kk").innerText = anggotaAktif.kk || "-";
            document.getElementById("bio-wa").innerText = anggotaAktif.whatsapp || "-";
            document.getElementById("bio-jk").innerText = anggotaAktif.jenis_kelamin || "-";
            document.getElementById("bio-tgl").innerText = formatTanggal(anggotaAktif.tanggal_lahir);
            document.getElementById("bio-usia").innerText = anggotaAktif.kualifikasi_usia || "-";
            document.getElementById("bio-badge-usia").innerText = anggotaAktif.kualifikasi_usia || "Anggota";
            document.getElementById("bio-alamat").innerText = anggotaAktif.alamat || "-";
        }

        // Render Data Agenda
        function renderAgenda() {
            const container = document.getElementById("list-agenda");
            const kueri = (document.getElementById("cari-agenda").value || "").toLowerCase();

            const filtered = dataAgenda.filter(item => {
                const teks = `${item.nama_kegiatan || ""} ${item.lokasi_kegiatan || ""} ${item.penyelenggara || ""}`.toLowerCase();
                return teks.includes(kueri);
            });

            document.getElementById("count-agenda").innerText = `${filtered.length} Agenda`;

            if (filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-xs text-slate-400">Tidak ada data agenda ditemukan.</div>`;
                return;
            }

            container.innerHTML = filtered.map(item => {
                const berkasHtml = renderTombolBerkas(item.foto, item.nama_kegiatan || "Dokumentasi Agenda");
                return `
                    <div class="p-3.5 rounded-xl border border-slate-200/80 bg-slate-50/70 hover:bg-white hover:shadow-sm transition-all flex items-start justify-between gap-3">
                        <div class="space-y-1 min-w-0">
                            <h3 class="text-sm font-bold text-slate-800">${esc(item.nama_kegiatan || "-")}</h3>
                            <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-slate-500">
                                <span><i class="fa-regular fa-calendar text-teal-600 mr-1"></i>${formatTanggal(item.tanggal_kegiatan)}</span>
                                <span><i class="fa-solid fa-location-dot text-rose-500 mr-1"></i>${esc(item.lokasi_kegiatan || "-")}</span>
                                <span><i class="fa-solid fa-user-tie text-indigo-500 mr-1"></i>${esc(item.penyelenggara || "-")}</span>
                            </div>
                        </div>
                        <div class="shrink-0">${berkasHtml}</div>
                    </div>
                `;
            }).join("");
        }

        // Render Jadwal Latihan
        function renderJadwalLatihan() {
            const container = document.getElementById("list-jadwal");
            const kueri = (document.getElementById("cari-jadwal").value || "").toLowerCase();

            const hariList = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
            const hariIni = hariList[new Date().getDay()];

            const banner = document.getElementById("banner-jadwal-hari-ini");
            const jadwalHariIni = dataRayon.filter(r => (r.jadwal_hari || "").toLowerCase().includes(hariIni.toLowerCase()));
            if (jadwalHariIni.length > 0) {
                banner.classList.remove("hidden");
                banner.innerHTML = `
                    <div class="flex items-center gap-2 mb-2">
                        <i class="fa-solid fa-bell text-amber-600"></i>
                        <h3 class="text-xs font-bold text-amber-800 uppercase tracking-wider">Jadwal Latihan Hari Ini (${hariIni})</h3>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                        ${jadwalHariIni.map(r => `
                            <div class="bg-white/80 px-3 py-2 rounded-xl border border-amber-200/70 flex items-center justify-between text-xs">
                                <span class="font-bold text-slate-800 truncate mr-2">${esc(r.nama_rayon_ranting)}</span>
                                <span class="text-amber-700 font-semibold whitespace-nowrap"><i class="fa-regular fa-clock mr-1"></i>${esc(r.jam_latihan || "-")}</span>
                            </div>
                        `).join("")}
                    </div>
                `;
            } else {
                banner.classList.add("hidden");
            }

            const filtered = dataRayon.filter(item => {
                const teks = `${item.nama_rayon_ranting || ""} ${item.kategori_rr || ""} ${item.lokasi_latihan || ""} ${item.jadwal_hari || ""} ${item.pelatih_tetap || ""}`.toLowerCase();
                return teks.includes(kueri);
            });

            const rayonAnggota = anggotaAktif ? (anggotaAktif.ranting_rayon || "").toLowerCase() : "";
            filtered.sort((a, b) => {
                const aMatch = (a.nama_rayon_ranting || "").toLowerCase() === rayonAnggota ? 1 : 0;
                const bMatch = (b.nama_rayon_ranting || "").toLowerCase() === rayonAnggota ? 1 : 0;
                return bMatch - aMatch;
            });

            document.getElementById("count-jadwal").innerText = `${filtered.length} Lokasi`;

            if (filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-xs text-slate-400">Tidak ada jadwal latihan ditemukan.</div>`;
                return;
            }

            container.innerHTML = filtered.map(item => {
                const isMilikAnggota = rayonAnggota && (item.nama_rayon_ranting || "").toLowerCase() === rayonAnggota;
                const isHariIni = (item.jadwal_hari || "").toLowerCase().includes(hariIni.toLowerCase());
                return `
                    <div class="p-3.5 rounded-xl border ${isMilikAnggota ? "border-emerald-300 bg-emerald-50/40" : "border-slate-200/80 bg-slate-50/70"} transition-all">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="text-sm font-bold text-slate-800">${esc(item.nama_rayon_ranting || "-")}</h3>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-100 text-purple-700">${esc(item.kategori_rr || "Rayon")}</span>
                                ${isMilikAnggota ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-600 text-white">Rayon Anda</span>` : ""}
                                ${isHariIni ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500 text-white">Latihan Hari Ini</span>` : ""}
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-[11px] text-slate-600 mt-2">
                            <div><i class="fa-regular fa-calendar-check text-purple-500 mr-1.5"></i><b>Hari:</b> ${esc(item.jadwal_hari || "-")}</div>
                            <div><i class="fa-regular fa-clock text-purple-500 mr-1.5"></i><b>Jam:</b> ${esc(item.jam_latihan || "-")}</div>
                            <div><i class="fa-solid fa-location-dot text-rose-500 mr-1.5"></i><b>Tempat:</b> ${esc(item.lokasi_latihan || "-")}</div>
                            <div><i class="fa-solid fa-user-shield text-blue-500 mr-1.5"></i><b>Pelatih:</b> ${esc(item.pelatih_tetap || "Belum Ditunjuk")}</div>
                        </div>
                    </div>
                `;
            }).join("");
        }

        // Render Laporan Kas
        function renderLaporanKas() {
            let totalMasuk = 0;
            let totalKeluar = 0;
            dataKeuangan.forEach(k => {
                const nom = parseFloat(k.nominal || 0);
                if (k.tipe === "pemasukan") totalMasuk += nom;
                else totalKeluar += nom;
            });
            const saldo = totalMasuk - totalKeluar;

            document.getElementById("kas-saldo").innerText = formatRupiah(saldo);
            document.getElementById("kas-masuk").innerText = "+ " + formatRupiah(totalMasuk);
            document.getElementById("kas-keluar").innerText = "- " + formatRupiah(totalKeluar);

            const filterTipe = document.getElementById("filter-kas-tipe").value;
            const kueri = (document.getElementById("cari-kas").value || "").toLowerCase();

            const filtered = dataKeuangan.filter(item => {
                const cocokTipe = !filterTipe || item.tipe === filterTipe;
                const cocokCari = (item.keterangan || "").toLowerCase().includes(kueri) || (item.tanggal || "").includes(kueri);
                return cocokTipe && cocokCari;
            });

            const tbody = document.getElementById("tbody-kas");
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-8 text-slate-400">Tidak ada transaksi kas ditemukan.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map((item, idx) => {
                const isMasuk = item.tipe === "pemasukan";
                const badgeTipe = isMasuk
                    ? `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 uppercase">Pemasukan</span>`
                    : `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700 uppercase">Pengeluaran</span>`;
                const nominalText = isMasuk
                    ? `<span class="font-bold text-emerald-600 whitespace-nowrap">+ ${formatRupiah(item.nominal)}</span>`
                    : `<span class="font-bold text-rose-600 whitespace-nowrap">- ${formatRupiah(item.nominal)}</span>`;

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-4 py-3 text-slate-500 font-medium">${idx + 1}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-slate-700">${formatTanggal(item.tanggal)}</td>
                        <td class="px-4 py-3">${badgeTipe}</td>
                        <td class="px-4 py-3">${nominalText}</td>
                        <td class="px-4 py-3 text-slate-700 min-w-[180px]">${esc(item.keterangan || "-")}</td>
                        <td class="px-4 py-3 text-center">${renderTombolBerkas(item.foto, item.keterangan || "Bukti Transaksi")}</td>
                    </tr>
                `;
            }).join("");
        }

        // Render Administrasi Surat
        function renderAdministrasiSurat() {
            const countMasuk = dataSurat.filter(s => s.jenis_surat === "Surat Masuk").length;
            const countKeluar = dataSurat.filter(s => s.jenis_surat === "Surat Keluar").length;
            document.getElementById("surat-masuk-count").innerText = countMasuk;
            document.getElementById("surat-keluar-count").innerText = countKeluar;

            const filterJenis = document.getElementById("filter-surat-jenis").value;
            const kueri = (document.getElementById("cari-surat").value || "").toLowerCase();

            const filtered = dataSurat.filter(item => {
                const cocokJenis = !filterJenis || item.jenis_surat === filterJenis;
                const teks = `${item.nomor_surat || ""} ${item.perihal || ""} ${item.sub_kategori || ""}`.toLowerCase();
                return cocokJenis && teks.includes(kueri);
            });

            const tbody = document.getElementById("tbody-surat");
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-slate-400">Tidak ada data surat ditemukan.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map((item, idx) => {
                const isMasuk = item.jenis_surat === "Surat Masuk";
                const badgeSurat = isMasuk
                    ? `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700 whitespace-nowrap">Surat Masuk</span>`
                    : `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-700 whitespace-nowrap">Surat Keluar</span>`;

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-4 py-3 text-slate-500 font-medium">${idx + 1}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-slate-700">${formatTanggal(item.tanggal_surat)}</td>
                        <td class="px-4 py-3">${badgeSurat}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-slate-600">${esc(item.sub_kategori || "-")}</td>
                        <td class="px-4 py-3 whitespace-nowrap font-semibold text-slate-800">${esc(item.nomor_surat || "-")}</td>
                        <td class="px-4 py-3 text-slate-700 min-w-[200px]">${esc(item.perihal || "-")}</td>
                        <td class="px-4 py-3 text-center">${renderTombolBerkas(item.foto, item.perihal || "Berkas Surat")}</td>
                    </tr>
                `;
            }).join("");
        }

        // Helper Render Berkas (Gambar / PDF / Excel)
        function renderTombolBerkas(fileData, judul) {
            if (!fileData) return `<span class="text-slate-300">-</span>`;
            const safeTitle = esc(judul);
            if (fileData.includes("application/pdf")) {
                return `<button type="button" onclick='bukaFileData(${safeJsonAttr(fileData)}, "berkas.pdf")' class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 text-[11px] font-bold cursor-pointer"><i class="fa-solid fa-file-pdf"></i> PDF</button>`;
            } else if (fileData.includes("spreadsheet") || fileData.includes("excel") || fileData.includes("text/csv")) {
                return `<button type="button" onclick='bukaFileData(${safeJsonAttr(fileData)}, "dokumen.xlsx")' class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-600 hover:bg-emerald-100 text-[11px] font-bold cursor-pointer"><i class="fa-solid fa-file-excel"></i> File</button>`;
            } else {
                return `<img src="${esc(fileData)}" alt="${safeTitle}" onclick='bukaPreviewFoto(${safeJsonAttr(fileData)}, ${safeJsonAttr(judul)})' class="w-9 h-9 rounded-lg object-cover border border-slate-200 cursor-pointer hover:scale-110 transition-transform mx-auto">`;
            }
        }

        // Buka PDF / Dokumen Base64 via Blob agar aman di semua browser
        function bukaFileData(dataUri, filename) {
            try {
                if (!dataUri.startsWith("data:")) {
                    window.open(dataUri, "_blank");
                    return;
                }
                const parts = dataUri.split(",");
                const mimeMatch = parts[0].match(/:(.*?);/);
                const mime = mimeMatch ? mimeMatch[1] : "application/octet-stream";
                const bstr = atob(parts[1]);
                let n = bstr.length;
                const u8arr = new Uint8Array(n);
                while (n--) {
                    u8arr[n] = bstr.charCodeAt(n);
                }
                const blob = new Blob([u8arr], { type: mime });
                const blobUrl = URL.createObjectURL(blob);
                const win = window.open(blobUrl, "_blank");
                if (!win) {
                    const a = document.createElement("a");
                    a.href = blobUrl;
                    a.download = filename;
                    a.click();
                }
            } catch (e) {
                alert("Tidak dapat membuka berkas.");
            }
        }

        function bukaPreviewFoto(src, caption) {
            document.getElementById("preview-img").src = src;
            document.getElementById("preview-caption").innerText = caption || "";
            document.getElementById("modal-preview").classList.remove("hidden");
        }

        function tutupPreviewFoto() {
            document.getElementById("modal-preview").classList.add("hidden");
        }

        // Navigasi Menu Sidebar
        function pilihTab(tab) {
            const judulMap = {
                semua: "Semua Data Anggota",
                biodata: "Biodata Pribadi Anggota",
                agenda: "Data Agenda Kegiatan",
                jadwal: "Jadwal Latihan Rayon & Ranting",
                kas: "Laporan Kas Organisasi",
                surat: "Administrasi Surat"
            };
            document.getElementById("topbar-title").innerText = judulMap[tab] || "Portal Anggota";

            document.querySelectorAll(".sidebar-btn").forEach(btn => {
                if (btn.dataset.tab === tab) {
                    btn.classList.add("sidebar-link-active");
                    btn.classList.remove("text-slate-300", "hover:bg-slate-800");
                } else {
                    btn.classList.remove("sidebar-link-active");
                    btn.classList.add("text-slate-300", "hover:bg-slate-800");
                }
            });

            const secBiodata = document.getElementById("sec-biodata");
            const secAgenda = document.getElementById("sec-agenda");
            const secJadwal = document.getElementById("sec-jadwal");
            const secKas = document.getElementById("sec-kas");
            const secSurat = document.getElementById("sec-surat");
            const gridAgendaJadwal = document.getElementById("grid-agenda-jadwal");

            [secBiodata, secAgenda, secJadwal, secKas, secSurat].forEach(el => el.classList.add("hidden"));

            if (tab === "semua") {
                [secBiodata, secAgenda, secJadwal, secKas, secSurat].forEach(el => el.classList.remove("hidden"));
                gridAgendaJadwal.classList.add("lg:grid-cols-2");
            } else if (tab === "biodata") {
                secBiodata.classList.remove("hidden");
            } else if (tab === "agenda") {
                secAgenda.classList.remove("hidden");
                gridAgendaJadwal.classList.remove("lg:grid-cols-2");
            } else if (tab === "jadwal") {
                secJadwal.classList.remove("hidden");
                gridAgendaJadwal.classList.remove("lg:grid-cols-2");
            } else if (tab === "kas") {
                secKas.classList.remove("hidden");
            } else if (tab === "surat") {
                secSurat.classList.remove("hidden");
            }

            // Tutup sidebar otomatis saat memilih menu di layar mobile
            if (window.innerWidth < 1024) {
                setSidebar(false);
            }
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        // Cek sesi login otomatis saat halaman di-refresh
        window.addEventListener("DOMContentLoaded", async () => {
            const savedId = sessionStorage.getItem("anggota_id_login");
            if (savedId) {
                try {
                    const snap = await database.ref("administrasi_digital/anggota/" + savedId).once("value");
                    if (snap.exists()) {
                        anggotaAktif = snap.val();
                        bukaPortalAnggota();
                    } else {
                        sessionStorage.removeItem("anggota_id_login");
                    }
                } catch (e) {
                    sessionStorage.removeItem("anggota_id_login");
                }
            }
        });
    </script>
