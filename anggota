<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Anggota - Pagar Nusa Qolbu Mukmin</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Firebase SDK (Compatibility Version) -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>

    <style>
        body {
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .sidebar-link-active {
            background-color: #059669;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
        }
        .table-scroll {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        ::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- ==================== HALAMAN LOGIN ANGGOTA ==================== -->
    <section id="page-login" class="flex-1 flex items-center justify-center p-4 sm:p-6 bg-gradient-to-br from-emerald-900 via-emerald-800 to-slate-900">
        <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden border border-emerald-700/20">
            <!-- Header Card Login -->
            <div class="bg-emerald-600 px-6 py-8 text-center text-white relative">
                <div class="w-20 h-20 bg-white/15 backdrop-blur-sm rounded-full flex items-center justify-center mx-auto mb-4 border-4 border-white/40 shadow-lg">
                    <i class="fa-solid fa-user-shield text-3xl text-white"></i>
                </div>
                <h1 class="text-xl sm:text-2xl font-black tracking-tight uppercase leading-tight">
                    Portal Anggota
                </h1>
                <p class="text-xs text-emerald-100 font-semibold uppercase tracking-widest mt-1">
                    Pagar Nusa Qolbu Mukmin
                </p>
            </div>

            <!-- Form Login -->
            <form id="form-login-anggota" onsubmit="prosesLoginAnggota(event)" class="p-6 sm:p-8 space-y-5">
                <div id="login-error" class="hidden bg-rose-50 border border-rose-200 text-rose-700 text-xs font-medium px-4 py-3 rounded-xl flex items-center gap-2.5">
                    <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm shrink-0"></i>
                    <span id="login-error-text">Nama anggota atau nomor WhatsApp tidak cocok.</span>
                </div>

                <div>
                    <label for="login-nama" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                        Nama Anggota
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <i class="fa-solid fa-user text-sm"></i>
                        </span>
                        <input type="text" id="login-nama" required autocomplete="name"
                            placeholder="Masukkan nama lengkap sesuai data"
                            class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all">
                    </div>
                </div>

                <div>
                    <label for="login-wa" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5">
                        Kata Sandi (Nomor WhatsApp)
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <i class="fa-brands fa-whatsapp text-base"></i>
                        </span>
                        <input type="password" id="login-wa" required inputmode="tel"
                            placeholder="Contoh: 081234567890 / 628..."
                            class="w-full pl-10 pr-11 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500 transition-all">
                        <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer" aria-label="Tampilkan sandi">
                            <i id="icon-eye" class="fa-solid fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" id="btn-login"
                    class="w-full bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold text-sm py-3.5 rounded-xl shadow-lg shadow-emerald-600/25 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>MASUK PORTAL ANGGOTA</span>
                </button>

                <p class="text-[11px] text-center text-slate-400 pt-1">
                    Gunakan Nama Lengkap & Nomor WhatsApp yang terdaftar di sistem.
                </p>
            </form>
        </div>
    </section>

    <!-- ==================== HALAMAN PORTAL ANGGOTA DENGAN SIDEBAR ==================== -->
    <section id="page-portal" class="hidden flex-1 flex min-h-screen overflow-x-hidden relative">

        <!-- OVERLAY SIDEBAR (MOBILE) -->
        <div id="sidebar-overlay" onclick="setSidebar(false)" class="fixed inset-0 bg-black/60 backdrop-blur-[1px] z-40 hidden lg:hidden transition-opacity"></div>

        <!-- SIDEBAR NAVIGASI ANGGOTA -->
        <aside id="portal-sidebar"
            class="fixed inset-y-0 left-0 z-50 w-72 shrink-0 bg-slate-900 text-slate-200 flex flex-col justify-between shadow-2xl transition-all duration-300 ease-in-out -translate-x-full lg:sticky lg:top-0 lg:h-screen lg:translate-x-0">
            
            <div class="flex flex-col flex-1 overflow-y-auto">
                <!-- Header Sidebar + Tombol Tutup -->
                <div class="px-4 py-4 bg-slate-950 border-b border-slate-800 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="w-9 h-9 rounded-xl bg-emerald-600/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs font-black tracking-wider text-white uppercase truncate">Portal Anggota</p>
                            <p class="text-[10px] text-slate-400 truncate">Pagar Nusa Qolbu Mukmin</p>
                        </div>
                    </div>
                    <button type="button" onclick="setSidebar(false)" title="Tutup Sidebar"
                        class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <!-- Profil Singkat di Sidebar -->
                <div class="p-4 border-b border-slate-800/80 bg-slate-900/50">
                    <div class="flex items-center gap-3">
                        <img id="sidebar-foto" src="https://via.placeholder.com/100" alt="Foto Profil"
                            class="w-11 h-11 rounded-full object-cover border-2 border-emerald-500 bg-white shrink-0">
                        <div class="min-w-0">
                            <p id="sidebar-nama" class="text-xs font-bold text-white truncate">Nama Anggota</p>
                            <p id="sidebar-rayon" class="text-[11px] text-emerald-400 font-medium truncate">Rayon / Ranting</p>
                        </div>
                    </div>
                </div>

                <!-- Menu Sidebar -->
                <nav class="p-3 space-y-1.5 flex-1">
                    <p class="px-3 pt-1 pb-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Menu Informasi</p>

                    <button type="button" onclick="pilihTab('semua')" data-tab="semua"
                        class="sidebar-btn sidebar-link-active w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-border-all w-4 text-center"></i>
                        <span>Semua Data</span>
                    </button>

                    <button type="button" onclick="pilihTab('biodata')" data-tab="biodata"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-id-card w-4 text-center text-emerald-400"></i>
                        <span>Biodata Pribadi</span>
                    </button>

                    <button type="button" onclick="pilihTab('agenda')" data-tab="agenda"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-calendar-days w-4 text-center text-teal-400"></i>
                        <span>Data Agenda</span>
                    </button>

                    <button type="button" onclick="pilihTab('jadwal')" data-tab="jadwal"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-clock w-4 text-center text-purple-400"></i>
                        <span>Jadwal Latihan</span>
                    </button>

                    <button type="button" onclick="pilihTab('kas')" data-tab="kas"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-wallet w-4 text-center text-emerald-400"></i>
                        <span>Laporan Kas</span>
                    </button>

                    <button type="button" onclick="pilihTab('surat')" data-tab="surat"
                        class="sidebar-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <i class="fa-solid fa-envelope-open-text w-4 text-center text-cyan-400"></i>
                        <span>Administrasi Surat</span>
                    </button>
                </nav>
            </div>

            <!-- Footer Sidebar (Tombol Keluar) -->
            <div class="p-4 bg-slate-950 border-t border-slate-800 space-y-2">
                <button type="button" onclick="prosesLogout()"
                    class="w-full bg-rose-600/90 hover:bg-rose-600 text-white text-xs font-bold py-2.5 px-4 rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Keluar Sistem</span>
                </button>
                <p class="text-[10px] text-center text-slate-500">Sistem Informasi Anggota</p>
            </div>
        </aside>

        <!-- AREA KONTEN UTAMA -->
        <div class="flex-1 flex flex-col min-w-0">

            <!-- Header Atas -->
            <header class="bg-emerald-700 text-white sticky top-0 z-30 shadow-md">
                <div class="px-4 sm:px-6 py-3.5 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <!-- Tombol Buka / Tutup Sidebar -->
                        <button type="button" onclick="toggleSidebar()" title="Buka / Tutup Sidebar"
                            class="w-10 h-10 rounded-xl bg-emerald-600 hover:bg-emerald-500 border border-emerald-500/40 flex items-center justify-center transition-colors shrink-0 cursor-pointer">
                            <i class="fa-solid fa-bars text-base"></i>
                        </button>
                        <div class="min-w-0">
                            <h1 id="topbar-title" class="text-sm sm:text-base font-bold truncate">Semua Data Anggota</h1>
                            <p id="topbar-subtitle" class="text-[11px] text-emerald-100 truncate">Pagar Nusa Qolbu Mukmin</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2.5 shrink-0">
                        <img id="header-foto" src="https://via.placeholder.com/100" alt="Foto Anggota"
                            class="hidden sm:block w-9 h-9 rounded-full object-cover border-2 border-emerald-300 bg-white">
                        <button type="button" onclick="prosesLogout()"
                            class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold px-3 py-2 rounded-xl shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span class="hidden sm:inline">Keluar</span>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Konten Utama -->
            <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">

                <!-- Alert Jadwal Latihan Hari Ini (Jika Ada) -->
                <div id="banner-jadwal-hari-ini" class="hidden bg-amber-50 border border-amber-200 border-l-4 border-l-amber-500 rounded-2xl p-4 shadow-sm"></div>

                <!-- 1. BIODATA LENGKAP ANGGOTA PRIBADI -->
                <section id="sec-biodata" class="portal-section bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/70 flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-id-card"></i>
                            </div>
                            <div>
                                <h2 class="text-sm sm:text-base font-bold text-slate-800">Biodata Lengkap Anggota</h2>
                                <p class="text-[11px] text-slate-500">Data pribadi resmi yang tercatat pada sistem</p>
                            </div>
                        </div>
                        <span id="bio-badge-usia" class="text-[11px] font-bold px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 shrink-0">-</span>
                    </div>

                    <div class="p-5 sm:p-6">
                        <div class="flex flex-col md:flex-row gap-6 items-center md:items-start">
                            <!-- Foto Profil -->
                            <div class="shrink-0 flex flex-col items-center">
                                <img id="bio-foto" src="https://via.placeholder.com/150" alt="Pas Foto Anggota"
                                    onclick="bukaPreviewFoto(this.src, document.getElementById('bio-nama').innerText)"
                                    class="w-32 h-40 sm:w-36 sm:h-44 rounded-2xl object-cover border-4 border-slate-100 shadow-md cursor-pointer hover:scale-[1.02] transition-transform bg-slate-100">
                                <span class="text-[10px] text-slate-400 mt-2"><i class="fa-solid fa-magnifying-glass-plus mr-1"></i>Klik foto untuk perbesar</span>
                            </div>

                            <!-- Grid Detail Biodata -->
                            <div class="flex-1 w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Nama Lengkap</p>
                                    <p id="bio-nama" class="text-sm font-bold text-slate-800 mt-0.5">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Nomor Induk Anggota (NIA)</p>
                                    <p id="bio-nia" class="text-sm font-bold text-emerald-700 mt-0.5">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Rayon / Ranting</p>
                                    <p id="bio-rayon" class="text-sm font-bold text-slate-800 mt-0.5">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">NIK (KTP)</p>
                                    <p id="bio-nik" class="text-sm font-semibold text-slate-700 mt-0.5">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Nomor Kartu Keluarga (KK)</p>
                                    <p id="bio-kk" class="text-sm font-semibold text-slate-700 mt-0.5">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Nomor WhatsApp</p>
                                    <p id="bio-wa" class="text-sm font-semibold text-slate-700 mt-0.5">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Jenis Kelamin</p>
                                    <p id="bio-jk" class="text-sm font-semibold text-slate-700 mt-0.5">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Tanggal Lahir</p>
                                    <p id="bio-tgl" class="text-sm font-semibold text-slate-700 mt-0.5">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Kualifikasi Usia</p>
                                    <p id="bio-usia" class="text-sm font-semibold text-slate-700 mt-0.5">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100 sm:col-span-2 lg:col-span-3">
                                    <p class="text-[10px] font-bold text-slate-400 uppercase">Alamat Domisili Lengkap</p>
                                    <p id="bio-alamat" class="text-sm font-semibold text-slate-700 mt-0.5">-</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- GRID 2 KOLOM DI DESKTOP UNTUK AGENDA & JADWAL LATIHAN -->
                <div id="grid-agenda-jadwal" class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                    <!-- 2. DATA AGENDA -->
                    <section id="sec-agenda" class="portal-section bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                        <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/70 flex flex-wrap items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-teal-100 text-teal-600 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-calendar-days"></i>
                                </div>
                                <div>
                                    <h2 class="text-sm sm:text-base font-bold text-slate-800">Data Agenda Kegiatan</h2>
                                    <p class="text-[11px] text-slate-500">Daftar rencana & kegiatan organisasi</p>
                                </div>
                            </div>
                            <span id="count-agenda" class="text-xs font-bold px-2.5 py-1 rounded-full bg-teal-50 text-teal-700 border border-teal-100">0 Agenda</span>
                        </div>
                        <div class="p-4 border-b border-slate-100">
                            <input type="text" id="cari-agenda" oninput="renderAgenda()" placeholder="Cari nama kegiatan, lokasi, atau penyelenggara..."
                                class="w-full text-xs px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-teal-500">
                        </div>
                        <div id="list-agenda" class="p-4 space-y-3 flex-1 max-h-[460px] overflow-y-auto">
                            <div class="text-center py-8 text-xs text-slate-400">Memuat data agenda...</div>
                        </div>
                    </section>

                    <!-- 3. JADWAL LATIHAN -->
                    <section id="sec-jadwal" class="portal-section bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                        <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/70 flex flex-wrap items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-clock"></i>
                                </div>
                                <div>
                                    <h2 class="text-sm sm:text-base font-bold text-slate-800">Jadwal Latihan Rayon & Ranting</h2>
                                    <p class="text-[11px] text-slate-500">Waktu, tempat latihan & penanggung jawab pelatih</p>
                                </div>
                            </div>
                            <span id="count-jadwal" class="text-xs font-bold px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 border border-purple-100">0 Lokasi</span>
                        </div>
                        <div class="p-4 border-b border-slate-100">
                            <input type="text" id="cari-jadwal" oninput="renderJadwalLatihan()" placeholder="Cari rayon/ranting, hari latihan, atau pelatih..."
                                class="w-full text-xs px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-purple-500">
                        </div>
                        <div id="list-jadwal" class="p-4 space-y-3 flex-1 max-h-[460px] overflow-y-auto">
                            <div class="text-center py-8 text-xs text-slate-400">Memuat jadwal latihan...</div>
                        </div>
                    </section>
                </div>

                <!-- 4. LAPORAN KAS -->
                <section id="sec-kas" class="portal-section bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/70 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                            <div>
                                <h2 class="text-sm sm:text-base font-bold text-slate-800">Laporan Kas Organisasi</h2>
                                <p class="text-[11px] text-slate-500">Transparansi saldo, pemasukan, dan pengeluaran</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 w-full sm:w-auto">
                            <select id="filter-kas-tipe" onchange="renderLaporanKas()" class="text-xs bg-white border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:border-emerald-500 font-semibold">
                                <option value="">Semua Transaksi</option>
                                <option value="pemasukan">Pemasukan</option>
                                <option value="pengeluaran">Pengeluaran</option>
                            </select>
                            <input type="text" id="cari-kas" oninput="renderLaporanKas()" placeholder="Cari keterangan..."
                                class="flex-1 sm:w-52 text-xs px-3 py-2 bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                        </div>
                    </div>

                    <!-- Ringkasan Saldo Kas -->
                    <div class="p-4 sm:p-5 grid grid-cols-1 sm:grid-cols-3 gap-3 bg-slate-50/50 border-b border-slate-100">
                        <div class="bg-slate-900 text-white p-4 rounded-2xl shadow-sm">
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Saldo Kas Saat Ini</p>
